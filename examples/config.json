{
  "listen": "127.0.0.1:1080",
  "observe": false,
  "block_quic": true,
  "groups": {
    "video": ["youtube.com", "googlevideo.com", "ytimg.com"],
    "discord": ["discord.com", "discord.gg", "discordapp.com"],
    "discord_web": ["discord.com", "discord.gg", "discordapp.com"],
    "discord_updates": ["updates.discord.com"],
    "discord_gateway": ["gateway.discord.gg"],
    "discord_voice": ["discord.media"],
    "discord_cdn": ["cdn.discordapp.com", "discordapp.net"]
  },
  "vantage": {
    "operator": "укажите-своего-оператора",
    "region": "RU-SPE",
    "access": "wired"
  },
  "probe_targets": ["www.youtube.com", "discord.com"],
  "control_targets": ["example.com", "ya.ru"],
  "transport_fallback": {
    "enabled": true,
    "entries": [
      {
        "safe_ip": "162.159.138.232",
        "domains": [
          "gateway.discord.gg",
          "media.discordapp.net"
        ]
      }
    ]
  },
  "autopilot": {
    "min_dwell": "15m",
    "trial_permille": 50,
    "baseline_margin": 0.2
  },
  "strategy": {
    "rules": [
      {
        "direction": "outbound",
        "trigger": { "match": "client_hello" },
        "action": {
          "kind": "duplicate",
          "left": {
            "kind": "tamper",
            "params": { "field": "tcp_checksum", "mode": "corrupt" },
            "left": {
              "kind": "tamper",
              "params": { "field": "payload", "mode": "replace", "length": 200 },
              "left": { "kind": "send" }
            }
          },
          "right": { "kind": "send" }
        }
      }
    ]
  },
  "strategies": {
    "discord_web": {"rules": [{"direction": "outbound", "trigger": {"match": "client_hello"}, "action": {"kind": "tcp_overlap", "params": {"preset": "tls_cover_681"}}}]},
    "discord_gateway": {"rules": [{"direction": "outbound", "trigger": {"match": "client_hello"}, "action": {"kind": "tcp_overlap", "params": {"preset": "tls_cover_681"}}}]},
    "discord_updates": {
      "rules": [
        {
          "direction": "outbound",
          "trigger": { "match": "client_hello" },
          "action": {
            "kind": "fragment",
            "params": { "proto": "tcp", "at": "inside_sni", "order": "reverse" },
            "left": { "kind": "send" },
            "right": { "kind": "send" }
          }
        }
      ]
    },
    "discord_voice": {
      "rules": [
        {
          "direction": "outbound",
          "trigger": { "match": "client_hello" },
          "action": {
            "kind": "duplicate",
            "left": {
              "kind": "tamper",
              "params": { "field": "tcp_seq", "mode": "add", "value": 4294957296 },
              "left": {
                "kind": "tamper",
                "params": { "field": "payload", "mode": "replace", "preset": "tls_clienthello_apple" },
                "left": { "kind": "send" }
              }
            },
            "right": {
              "kind": "fragment",
              "params": { "proto": "tcp", "at": "inside_sni", "order": "forward" },
              "left": { "kind": "send" },
              "right": { "kind": "send" }
            }
          }
        }
      ]
    },
    "discord_cdn": {
      "rules": [
        {
          "direction": "outbound",
          "trigger": { "match": "client_hello" },
          "action": {
            "kind": "tcp_overlap",
            "params": { "preset": "tls_cover_681" }
          }
        }
      ]
    }
  }
}
