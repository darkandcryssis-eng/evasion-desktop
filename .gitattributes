# Скрипты PowerShell: перевод строк CRLF и метка BOM обязательны.
#
# Windows PowerShell 5.1 читает .ps1 без метки BOM в системной кодировке
# (cp1251 на русской Windows), а не в UTF-8. Русский текст в комментариях и
# строках при этом превращается в мусор, вместе с ним ломаются кавычки и тире,
# и скрипт перестаёт разбираться. Метка BOM — часть содержимого файла, здесь
# закреплены только переводы строк, чтобы git их не нормализовал.
*.ps1 text eol=crlf

# Конфиги JSON, напротив, обязаны быть без метки BOM: строгий разбор в Go на
# ней падает. Явная бинарная обработка исключает любые преобразования.
*.json text eol=lf

# Батники cmd.exe: перевод строк CRLF обязателен. С одними LF cmd спотыкается
# на метках (:label) и goto — скрипт работает через раз.
*.bat text eol=crlf
